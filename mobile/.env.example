# Selit app. Copy to .env for local development. Cloud builds read the same
# values from the GitHub repository secrets SUPABASE_URL and SUPABASE_ANON_KEY.
# Leave the Supabase values empty to run the whole app on built-in sample data.

# Supabase → Project Settings → API. The anon key is public by design;
# row-level security in the database decides what each person can do.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional. The website (used for share links) and the support inbox.
EXPO_PUBLIC_SITE_URL=https://selit.ng
EXPO_PUBLIC_SUPPORT_EMAIL=support@selit.ng
