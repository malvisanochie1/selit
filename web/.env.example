# Selit website. Copy to .env.local for development.
# Leave the Supabase values empty to run the whole site on built-in sample data.

# Supabase → Project Settings → API. The anon key is public by design;
# row-level security in the database decides what each visitor can do.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site address, used for email links, share links and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where safety and account emails go.
NEXT_PUBLIC_SUPPORT_EMAIL=support@selit.ng
